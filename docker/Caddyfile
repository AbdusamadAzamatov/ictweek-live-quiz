# ICTWEEK quiz — TLS + reverse proxy. DOMAIN comes from docker/.env.
# Caddy obtains and renews the certificate automatically (internal CA
# for localhost / private domains).
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
