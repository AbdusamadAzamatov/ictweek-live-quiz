# Copy to docker/.env and fill in. Never commit docker/.env.

# Public hostname Caddy serves TLS for — DNS A record must point at this host.
# Use "localhost" for a local check (Caddy issues an internal certificate).
DOMAIN=quiz.example.com

# Public URL of the app — must be https://<DOMAIN>. Used for join links/QR
# codes, the CSRF Origin check and secure cookies.
PUBLIC_URL=https://quiz.example.com

# Postgres password. The db container is not exposed outside the stack.
POSTGRES_PASSWORD=change-me-strong-password

# App's database connection — points at the compose "db" service.
# (compose.yml re-sets this with the interpolated password; kept here for reference)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/ictquiz

# Server secret (reserved for signed cookies; organizer sessions are opaque
# random tokens stored hashed). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-with-openssl-rand-hex-32

# Upload directory inside the app container (backed by the "media" volume).
MEDIA_DIR=/data/media

# Bootstrap organizer — created only while the organizer table is empty.
# Remove both variables after the first login.
INITIAL_ORGANIZER_EMAIL=admin@example.com
INITIAL_ORGANIZER_PASSWORD=ChangeMe123!

# Maximum image upload size, in megabytes.
MAX_UPLOAD_MB=5

# Trust the Caddy reverse proxy so rate limits key on the real client IP
# (X-Forwarded-For). Required behind the bundled Caddy.
TRUST_PROXY=1

# Optional: tag for the app image (used by rollback runbook, e.g. a git sha).
#APP_TAG=latest
