{
  "name": "@ictquiz/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.src.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
